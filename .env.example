# =====================================================
# NEWS SUMMARIZER AGENT - ENVIRONMENT VARIABLES
# =====================================================
#
# HOW TO USE:
# 1. Copy this file and rename to: .env
# 2. Replace the placeholder with your real API key
# 3. Never commit .env to git (it contains secrets!)
#
# =====================================================

# Your Anthropic API Key (required)
# Get one at: https://console.anthropic.com/
# It should start with: sk-ant-api03-
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NewsAPI Key (optional - for fetching from NewsAPI)
# Get one at: https://newsapi.org/
# Free tier: 100 requests/day
NEWS_API_KEY=your_newsapi_key_here

# Frontend URL (optional - set when deploying so the backend's CORS allows it)
# Example: https://news-summarizer-frontend.onrender.com
# FRONTEND_URL=https://your-frontend.onrender.com

# Database URL (optional - defaults to sqlite:///./news.db)
# Articles and Q&A history persist here so they survive backend restarts.
# Use a Postgres URL like postgresql+psycopg://user:pass@host/db in production.
# DATABASE_URL=sqlite:///./news.db
